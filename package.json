{
  "name": "dsh-brave",
  "description": "Brave Search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "brave"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
